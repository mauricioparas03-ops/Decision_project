    "        all_days_data[\"Hum\"].append(value(model.Hum[t, d]))\n",
    "        all_days_data[\"price\"].append(value(model.prices[d, t]))\n",
    "        all_days_data[\"Occ_r1\"].append(Occ_r1.iloc[d, t])\n",
